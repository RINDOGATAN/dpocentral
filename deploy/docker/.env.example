# DPO Central community edition: settings for deploy/docker/docker-compose.yml.
# Copy to .env next to the compose file and run `chmod 600 .env`.

# ---- Required ----------------------------------------------------------------
# Database password (any long random string): openssl rand -hex 24
POSTGRES_PASSWORD=
# Session signing secret: openssl rand -base64 32
NEXTAUTH_SECRET=
# The address people open in the browser. Baked into the build: rebuild after
# changing it (docker compose up -d --build app).
PUBLIC_URL=http://localhost:8485

# ---- Network -----------------------------------------------------------------
# 127.0.0.1 keeps the app on this machine. 0.0.0.0 opens it to the network:
# firewall it first (see README.md, Hardening).
BIND_ADDR=127.0.0.1
PORT=8485
# The optional tls profile: docker compose --profile tls up -d
# TLS_DOMAIN=dpo.example.com

# ---- Sign-in -----------------------------------------------------------------
# Local passwordless sign-in (any e-mail address signs in). Only for a machine
# or a network you trust. Baked into the build.
NEXT_PUBLIC_LOCAL_AUTH_ENABLED=true
# E-mail sign-in links through Resend (optional): set the key and switch on.
NEXT_PUBLIC_EMAIL_AUTH_ENABLED=false
RESEND_API_KEY=
# Google sign-in with your own OAuth client (optional).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty for host-only cookies (correct for almost every install).
AUTH_COOKIE_DOMAIN=

# ---- Daily jobs ----------------------------------------------------------------
# Rights-request redaction and deadline reminders: openssl rand -hex 32
# Empty: the cron service logs a warning and the endpoints refuse to run.
CRON_SECRET=

# ---- Brand (baked into the build) ------------------------------------------------
NEXT_PUBLIC_BRAND_NAME=DPO Central
NEXT_PUBLIC_BRAND_ACCENT=
NEXT_PUBLIC_BRAND_LOGO_URL=

# ---- Modules -------------------------------------------------------------------
# "false" leaves the rights-request module out (menu, pages, public form).
NEXT_PUBLIC_DSAR_ENABLED=

# ---- Operators ---------------------------------------------------------------
# Comma-separated e-mail addresses that receive technical messages.
ADMIN_EMAILS=
CONTACT_EMAIL=
# The public address of the source you run, for the licence page (AGPL §13).
NEXT_PUBLIC_SOURCE_URL=

# ---- Backups (backup.sh / restore.sh) --------------------------------------------
BACKUP_PASSPHRASE=
# BACKUP_RCLONE_REMOTE=

# ---- Evaluation only ---------------------------------------------------------------
# DEMO_SEED=true seeds a sample organization on the first boot.
# DEMO_SEED=
