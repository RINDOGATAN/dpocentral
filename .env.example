# DPO Central community edition: settings for `npm run dev` / `npm start`.
# The defaults match the development database in docker-compose.yml.
# For the Docker install use deploy/docker/.env.example instead.

# Database
DATABASE_URL="postgresql://dpocentral:dpocentral_dev@localhost:5434/dpocentral?schema=public"

# Sessions
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="change-me"   # openssl rand -base64 32

# The address of this instance (links in e-mails, the licence page).
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Sign-in methods (enable at least one)
# Local passwordless sign-in: for your own machine or a network you trust,
# never on the public internet. Always on under `npm run dev`.
NEXT_PUBLIC_LOCAL_AUTH_ENABLED="true"
# E-mail sign-in links through Resend (optional):
RESEND_API_KEY=""
NEXT_PUBLIC_EMAIL_FROM=""      # e.g. noreply@your-domain.example
# Google sign-in with your own OAuth client (optional):
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Auth cookie scope. Leave unset for host-only cookies (correct for almost
# every deployment). Set to a parent domain (".example.com") only for
# single sign-on across subdomains.
# AUTH_COOKIE_DOMAIN=""
# The same for the language cookie, so sibling apps share the choice.
# NEXT_PUBLIC_LOCALE_COOKIE_DOMAIN=""

# Brand and legal links (optional; links left empty are not shown)
# NEXT_PUBLIC_BRAND_NAME="DPO Central"
# NEXT_PUBLIC_COMPANY_NAME=""
# NEXT_PUBLIC_TERMS_URL=""
# NEXT_PUBLIC_PRIVACY_URL=""
# NEXT_PUBLIC_SUPPORT_EMAIL=""

# Operators: comma-separated addresses that receive technical messages and,
# on the licence page, requests for the source.
ADMIN_EMAILS=""
CONTACT_EMAIL=""

# The public address of the source you run, for the licence page (/licenses,
# AGPL-3.0 section 13). Point it at your own repository if you modify the code.
NEXT_PUBLIC_SOURCE_URL="https://github.com/RINDOGATAN/dpocentral"
# NEXT_PUBLIC_COMMIT_SHA=""
# "false" shows an offer to send the source on request instead of the link.
NEXT_PUBLIC_SOURCE_PUBLIC=true

# Rate limits (src/lib/rate-limit.ts). Per-process, in-memory counters keyed
# by the client address from x-forwarded-for, meaningful only behind a proxy
# that sets it. Defaults: SIGNIN 10/60, MAGIC_LINK 5/900, AUTH 30/60,
# DSAR_PUBLIC 5/600, EXPORT 10/60, HEALTH 60/60, CRON 10/60 (requests per
# seconds). Override one with RATE_LIMIT_<NAME>="<count>/<seconds>".
# RATE_LIMIT_SIGNIN="10/60"
# Set to "true" only when a reverse proxy in front already limits.
# RATE_LIMIT_DISABLED=""
# /api/health caches its database probe for this many milliseconds (0 = probe
# on every call). Default 10000.
# HEALTH_CACHE_MS=""

# Daily jobs: GET /api/cron/dsar-redaction and /api/cron/dsar-reminders with
# "Authorization: Bearer $CRON_SECRET". The endpoints refuse to run without it.
CRON_SECRET=""

# Rights-request (DSAR) module. On unless set to exactly "false". "false"
# leaves the module out: menu, pages, public form and status pages (404), API,
# reminders and report sections. Records already held stay until purged
# (scripts/purge-dsar-data.ts). Baked at build time: rebuild after changing it.
# NEXT_PUBLIC_DSAR_ENABLED="false"
